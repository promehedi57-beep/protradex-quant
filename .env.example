# ---- Feed ----
FEED=binance
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
QUOTE_ASSET=USDT
MIN_24H_QUOTE_VOLUME=10000000
MAX_PAIRS=200
TIMEFRAME=1m
BUFFER_CANDLES=300
MIN_CANDLES=60
PAIR_REFRESH_HOURS=12

# ---- Forex session gate ----
FOREX_SESSION_ENABLED=true
# OTC blackout windows (UTC), comma separated, e.g. "21:55-22:05"
OTC_BLACKOUT=

# ---- Rules thresholds ----
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
ZSCORE_PERIOD=20
ZSCORE_ENTRY=2.0
LINREG_PERIOD=14
DONCHIAN_PERIOD=20
ADX_PERIOD=14
ADX_STRONG=25
ATR_PERIOD=14
SL_ATR=1.2
TP_ATR=1.8
EMA_FAST=20
EMA_SLOW=50
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# ---- Engine ----
ENGINE_BUDGET_MS=50
MIN_CONFIDENCE=65
SIGNAL_COOLDOWN_MS=300000
MIN_INTERVAL_MS=60000

# ---- Telegram ----
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=8647348457:AAFfc6H7pDZdLAJmbGI6S3-Ra6MDnQKYP8A
TELEGRAM_CHAT_ID=-1003700486044

# ---- Execution (default DRY-RUN — real-money safety) ----
EXECUTION_ENABLED=false
EXECUTOR=extension
EXTENSION_WS_PORT=8787
QUOTEX_URL=https://quotex.io/
QUOTEX_PROFILE_DIR=./.quotex-profile
QUOTEX_ASSET_INPUT=input[placeholder*="Search"], input[placeholder*="Поиск"]
QUOTEX_ASSET_ITEM=.asset-item, .search-result__item
QUOTEX_CALL_BTN=[data-testid="call-button"], button[class*="call"]
QUOTEX_PUT_BTN=[data-testid="put-button"], button[class*="put"]
# optional symbol map: {"BTCUSDT":"Bitcoin","ETHUSDT":"Ethereum"}
QUOTEX_SYMBOL_MAP=

# ---- TradingView webhook ----
WEBHOOK_ENABLED=false
WEBHOOK_PORT=8788
WEBHOOK_SECRET=

# ---- OANDA (real forex) ----
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
OANDA_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,XAU_USD

# ---- Ops ----
STATS_INTERVAL_S=30
HEARTBEAT_ALERT_S=180
# ---- Dashboard ----
PORT=10000
DASHBOARD_ENABLED=true
DASHBOARD_USER=
DASHBOARD_PASS=
DASHBOARD_REFRESH_MS=2000

# ---- Telegram 2-way bot ----
TELEGRAM_POLL_TIMEOUT=30
# নিরাপত্তা: শুধু এই chat IDs কন্ট্রোল করতে পারবে (কমা দিয়ে একাধিক) — ফাঁকা = সবাই
TELEGRAM_ALLOWED_CHAT_IDS=

# নোট: TradingView webhook এখন একই পোর্টে (PORT) — /webhook পাথ, /health হেলথচেক
# ── Phase 4 · Telegram STRICT security ──
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=8647348457:AAFfc6H7pDZdLAJmbGI6S3-Ra6MDnQKYP8A
TELEGRAM_ALERTS_ENABLED=true          # OFF করলে শুধু notification বন্ধ; dashboard চলতেই থাকবে
TELEGRAM_ALLOWED_CHAT_IDS=-1003700486044          # STRICT whitelist — খালি থাকলে কাউকে command দিতে দেবে না
TELEGRAM_ADMIN_IDS=7689218221                 # admin-only: /alerts, /broadcast
TELEGRAM_BROADCAST_TARGETS=ALLOWED           # group/channel/admin ID — খালি হলে ALLOWED ব্যবহার হবে

# ── Phase 4 · Multi-timeframe + S/R + confidence ──
TIMEFRAMES=5,10,15,20
ACTIVE_TIMEFRAME=15
SR_ENABLED=true
SR_LOOKBACK=48
SR_BREAKOUT_PCT=0.15
CONF_W_RSI=0.25
CONF_W_ZSCORE=0.25
CONF_W_SR=0.25
CONF_W_TF=0.25

# ── Phase 4 · OTC simulated feed (24/7) ──
OTC_ENABLED=true
OTC_TICK_MS=1000
OTC_SYMBOLS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,AUDUSD_otc,XAUUSD_otc,BTCUSD_otc,ETHUSD_otc,SOLUSD_otc

PAIR_LIMIT=24
